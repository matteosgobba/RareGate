# Python bytecode, packaging, and build outputs
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments and local configuration
.venv/
.venv-*/
venv/
env/
ENV/
.env
.env.*
!.env.example
.python-version

# Test, lint, coverage, and notebook caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# macOS and editor metadata
.DS_Store
._*
.AppleDouble/
.LSOverride
.idea/
.vscode/
*.swp
*.swo
*~
.Rhistory

# Local datasets and derived stores
/data/*
*.root
*.h5
*.hdf5
*.parquet
*.npz

# Publish only the selected scientific tables and figures.
/results/*
!/results/figures/
!/results/tables/
/results/figures/*
!/results/figures/quality-cost.png
!/results/figures/signal-efficiency.png
!/results/figures/paired-cost-ratios.png
/results/tables/*
!/results/tables/background-acceptance.csv
!/results/tables/cpu-costs.csv
!/results/tables/paired-inference.csv
!/results/tables/robustness.csv
!/results/tables/signal-operating-points.csv

# Public documentation is an explicit allowlist; local research records stay local.
/docs/*
!/docs/scientific-report.md
!/docs/experiment-design.md
!/docs/data-preparation.md
!/docs/evaluation-methods.md
!/docs/usage-guide.md
!/docs/earlier-studies.md

# Local notes, manuscript workspaces and publication backups
/.private/
/project_report/
/notebooks/
/assets/branding/*.md
/assets/branding/raregate-logo-v1.png

# Internal campaign drivers and their receipt-bound configurations
/scripts/*
!/scripts/smoke_test.py
!/scripts/analyze_training_data.py
!/scripts/audit_raw_data.py
!/scripts/validate_preprocessing.py
/configs/*
!/configs/data/
!/configs/models/
!/configs/dependencies/

# Publish the numerical suite; retain campaign-specific checks locally.
/tests/*
!/tests/__init__.py
!/tests/unit/

# Checkpoints, model exports, and experiment artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.mlmodel
*.mlpackage/
# Only deliberately curated tiny v1/v2 JSON models are tracked.
/artifacts/*
!/artifacts/models/
/artifacts/models/*
!/artifacts/models/compact-autoencoder-v1/
/artifacts/models/compact-autoencoder-v1/*
!/artifacts/models/compact-autoencoder-v1/model.json
!/artifacts/models/compact-autoencoder-v2/
/artifacts/models/compact-autoencoder-v2/*
!/artifacts/models/compact-autoencoder-v2/model.json
/checkpoints/
/models/
/outputs/
/runs/
/wandb/
/mlruns/
/lightning_logs/
*.log
